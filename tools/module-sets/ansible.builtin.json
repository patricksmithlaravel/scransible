{
  "collection": "ansible.builtin",
  "title": "Ansible builtins",
  "modules": {
    "include_tasks": { "category": "control", "palette": ["file"] },
    "import_tasks": { "category": "control", "palette": ["file"] },
    "meta": { "category": "control", "palette": ["_raw"], "defaults": { "_raw": "flush_handlers" } },
    "fail": { "category": "control", "palette": ["msg"] },
    "set_fact": { "category": "variables", "palette": [], "freeArgs": true, "defaults": { "new_fact": "" } },
    "include_vars": { "category": "variables", "palette": ["file"] },
    "include_role": { "category": "roles", "palette": ["name"] },
    "import_role": { "category": "roles", "palette": ["name"] },
    "apt": { "category": "packages", "palette": ["name", "state", "update_cache"], "defaults": { "state": "present" } },
    "dnf": { "category": "packages", "palette": ["name", "state"], "defaults": { "state": "present" } },
    "package": { "category": "packages", "palette": ["name", "state"], "defaults": { "state": "present" } },
    "pip": { "category": "packages", "palette": ["name", "virtualenv"] },
    "apt_repository": { "category": "packages", "palette": ["repo", "state"], "defaults": { "state": "present" } },
    "copy": { "category": "files", "palette": ["src", "dest"] },
    "template": { "category": "files", "palette": ["src", "dest"] },
    "file": { "category": "files", "palette": ["path", "state"], "defaults": { "state": "directory" } },
    "lineinfile": { "category": "files", "palette": ["path", "line"] },
    "blockinfile": { "category": "files", "palette": ["path", "block"] },
    "unarchive": { "category": "files", "palette": ["src", "dest"] },
    "get_url": { "category": "files", "palette": ["url", "dest"] },
    "stat": { "category": "files", "palette": ["path"] },
    "service": { "category": "services", "palette": ["name", "state", "enabled"], "defaults": { "state": "started" } },
    "systemd_service": { "category": "services", "palette": ["name", "state", "daemon_reload"], "defaults": { "state": "started" } },
    "cron": { "category": "services", "palette": ["name", "job"] },
    "reboot": { "category": "services", "palette": ["msg"] },
    "command": { "category": "commands", "palette": ["cmd", "chdir"] },
    "shell": { "category": "commands", "palette": ["cmd"] },
    "script": { "category": "commands", "palette": ["_raw"] },
    "raw": { "category": "commands", "palette": ["_raw"] },
    "user": { "category": "access", "palette": ["name", "groups"] },
    "group": { "category": "access", "palette": ["name"] },
    "debug": { "category": "utilities", "palette": ["msg"] },
    "assert": { "category": "utilities", "palette": ["that"] },
    "uri": { "category": "utilities", "palette": ["url", "method"] },
    "wait_for": { "category": "utilities", "palette": ["port", "timeout"] },
    "pause": { "category": "utilities", "palette": ["seconds"] },
    "setup": { "category": "utilities", "palette": ["gather_subset"] }
  }
}
